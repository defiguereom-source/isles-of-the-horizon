--- !u!114 &2014791672
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2014791665}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 055300d69ed058345b07ddb30a9e0e7e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: '::'
  dialogMark: {fileID: 1299720583}
  dialogPanel: {fileID: 682759025}
  dialogText: {fileID: 1627260540}
  mainDialogLines:
  - Oh, ya llegaste.
  - No se que pasa... Gregory desaparecio sin dejar rastro.
  - Te noto diferente.
  - Bueno... ahora no hay tiempo para eso.
  - "Tenemos que encontrar a Gregory. \xBFSabes usar una espada?"
  - Presiona J para atacar.
  - Manten Shift y presiona una tecla de direccion para correr.
  - "Ou, \xBFLo entendiste?"
  - "Ve al bosque. Si Gregory sigue con vida, probablemente est\xE9 all\xED."
  - Ve a despedirte del pueblo antes de matar a la calamidad
  secondaryDialogs:
  - name: 1er Dialog
    lines:
    - 'Ve a despedirte del pueblo antes de matar a la calamidad '
  loopSecondaryDialogs: 1
  interactionCooldown: 2
